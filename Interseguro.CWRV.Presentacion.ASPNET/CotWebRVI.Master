	<script type="text/javascript">
		$.ajaxSetup({
			type: 'POST',
			headers: { "cache-control": "no-cache" }
		});

		$(document).ready(function () {

			function desplagar() { $('ul', this).slideDown(200); }
			function replegar() { $('ul', this).slideUp(200); }

			$("#Menu li").hoverIntent({
				over: desplagar,
				timeout: 20,
				out: replegar
			});

			$('input, select').keypress(function (event) { return event.keyCode != 13; });

			$clock = $("#Sesion").on("update.countdown", function (event) {
				var format = '%M:%S';
				$(this).html(event.strftime(format));
			}).on('finish.countdown', function (event) {
				CerrarSesionExpirada();
			});

			selectedDate = new Date().valueOf() + parseFloat($("#Timeout").val());
			$clock.countdown(selectedDate.toString());
		});

		function CerrarSesionExpirada() {
			window.location.href = '<%=ResolveUrl("~/Seguridad/SesionExpirada.aspx")%>';
		}

		function base64ABytes(base64) {
            var s = window.atob(base64);
            var bytes = new Uint8Array(s.length);
            for (var i = 0; i < s.length; i++) {
                bytes[i] = s.charCodeAt(i);
            }
            return bytes;
        }

        function JSONstringifyConFechas(obj) {
            return JSON.stringify(obj).replace(/\/Date/g, "\\\/Date").replace(/\)\//g, "\)\\\/")
        }
	</script>

    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
