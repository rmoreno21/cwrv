<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="CWRV.Movil.master.cs" Inherits="Interseguro.CWRV.Presentacion.ASPNET.CWRV_Movil" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="HandheldFriendly" content="true" />
    <title>Interseguro | Cotizador Web de Rentas </title>

    <link type="image/x-icon" href="<%=ResolveUrl("~/Imagenes/favicon.ico")%>" rel="shortcut icon" />
    <link type="image/x-icon" href="<%=ResolveUrl("~/Imagenes/favicon.ico")%>" rel="icon" />

    <link rel="stylesheet" href="http://code.jquery.com/mobile/1.4.5/jquery.mobile-1.4.5.min.css" />
    <script src="http://code.jquery.com/jquery-1.11.3.min.js"></script>
    <script src="http://code.jquery.com/mobile/1.4.5/jquery.mobile-1.4.5.min.js"></script>

    <style>
        .ui-page .ui-header {
            background: #00a3e1 url(../Imagenes/logo_is_celeste_30.png) no-repeat center center !important;
            height: 40px;
        }

        .ui-page-theme-b .ui-btn, html .ui-bar-b .ui-btn, html .ui-body-b .ui-btn, html body .ui-group-theme-b .ui-btn, html head + body .ui-btn.ui-btn-b, .ui-page-theme-b .ui-btn:visited, html .ui-bar-b .ui-btn:visited, html .ui-body-b .ui-btn:visited, html body .ui-group-theme-b .ui-btn:visited, html head + body .ui-btn.ui-btn-b:visited {
            background-color: #084a8e;
            border-color: #fff;
            color: #fff;
            text-shadow: 0 1px 0 #111;
        }

        .ui-page-theme-b .ui-btn, html .ui-bar-b .ui-btn, html .ui-body-b .ui-btn, html body .ui-group-theme-b .ui-btn, html head + body .ui-btn.ui-btn-b, .ui-page-theme-b .ui-btn:visited, html .ui-bar-b .ui-btn:visited, html .ui-body-b .ui-btn:visited, html body .ui-group-theme-b .ui-btn:visited, html head + body .ui-btn.ui-btn-b:hover {
            background-color: #0959aa;
            border-color: #fff;
            color: #fff;
            text-shadow: 0 1px 0 #111;
        }

        .ui-li-static.ui-collapsible > .ui-collapsible-heading {
            margin: 0;
        }
        .ui-li-static.ui-collapsible {
            padding: 0;
        }
        .ui-li-static.ui-collapsible > .ui-collapsible-heading > .ui-btn {
            border-top-width: 0;
        }
        .ui-li-static.ui-collapsible > .ui-collapsible-heading.ui-collapsible-heading-collapsed > .ui-btn,
        .ui-li-static.ui-collapsible > .ui-collapsible-content {
            border-bottom-width: 0;
        }
    </style>

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div data-role="page">
            <div data-role="panel" id="overlayPanel" data-display="overlay">
                <h3 style="margin:0 0 30px 0">Cotizador Web de<br />
                    Rentas Vitalicias</h3>
                <ul data-role="listview" class="ui-listview-outer">
                    <li><a href="#">Cotizador</a></li>
                    <li data-role="collapsible" data-iconpos="right" data-shadow="false" data-corners="false">
                        <h2>Reportes</h2>
                        <ul data-role="listview" data-shadow="false" data-corners="false">
                            <li><a href="#" style="margin-left:5px">Reporte de Seguimiento</a></li>
                            <li><a href="#" style="margin-left:5px">Reporte de Supervisión</a></li>
                        </ul>
                    </li>
                    <li data-role="collapsible" data-iconpos="right" data-shadow="false" data-corners="false">
                        <h2>Simuladores</h2>
                        <ul data-role="listview" data-shadow="false" data-corners="false">
                            <li><a href="#" style="margin-left:5px">Jubilarse Hoy o a Futuro</a></li>
                            <li><a href="#" style="margin-left:5px">Renta Vitalicia o Retiro Programado</a></li>
                            <li><a href="#" style="margin-left:5px">Renta Inmediata o Diferida</a></li>
                            <li><a href="#" style="margin-left:5px">Tipo de Moneda</a></li>
                        </ul>
                    </li>
                    <li data-role="collapsible" data-iconpos="right" data-shadow="false" data-corners="false">
                        <h2>Configuración</h2>
                        <ul data-role="listview" data-shadow="false" data-corners="false">
                            <li><a href="#" style="margin-left:5px">Monto CICs</a></li>
                        </ul>
                    </li>
                </ul>
                <br />
                <a href="<%=ResolveUrl("~/Seguridad/CerrarSesion.aspx")%>" data-ajax="false" class="ui-btn ui-icon-power ui-btn-icon-left">Cerrar Sesión</a>
            </div>

            <div data-role="header" data-position="fixed">
                <a href="#overlayPanel" class="ui-nodisc-icon ui-btn-left ui-btn ui-btn-b ui-icon-bars ui-btn-icon-notext ui-corner-all" data-role="button" role="button">Menu</a>
            </div>

            <div data-role="main" class="ui-content">
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                </asp:ContentPlaceHolder>
            </div>

            <div data-role="footer">
                <h1>© Copyright 2013 - <% Response.Write(DateTime.Now.Year.ToString()); %><br />
                    Interseguro - Tecnología de la Información</h1>
            </div>
        </div>
    </form>
</body>
</html>
