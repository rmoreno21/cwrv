<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<configSections>
		<section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler,Log4net" />
		<section name="cotizaciones" type="Interseguro.CWRV.Infraestructura.General.SeccionCotizaciones" allowLocation="true" allowDefinition="Everywhere" />
		<section name="correo" type="Interseguro.CWRV.Infraestructura.General.SeccionCorreo" allowLocation="true" allowDefinition="Everywhere" />
		<section name="cotizacionesRPPlus" type="Interseguro.CWRV.Infraestructura.General.SeccionCotizacionesRPPlus" allowLocation="true" allowDefinition="Everywhere" />
		<section name="cotizacionesRP" type="Interseguro.CWRV.Infraestructura.General.SeccionCotizacionesRP" allowLocation="true" allowDefinition="Everywhere" />
		<section name="keyConfiguration" type="System.Configuration.NameValueFileSectionHandler" />
	</configSections>

	<log4net>
		<root>
			<level value="ALL" />
			<appender-ref ref="LogFileAppender" />
		</root>
		<appender name="LogFileAppender" type="log4net.Appender.RollingFileAppender">
			<param name="File" type="log4net.Util.PatternString" value="Logs\\CWRV.Presentacion.%date{yyyyMMdd}.log" />
			<param name="AppendToFile" value="true" />
			<rollingStyle value="Date" />
			<datePattern value="yyyyMMdd" />
			<staticLogFileName value="true" />
			<layout type="log4net.Layout.PatternLayout">
				<param name="ConversionPattern" value="%date [%thread] %-5level [%type.%method] [%aspnet-request{AUTH_USER}] [%aspnet-request{REMOTE_ADDR}] - %message%newline" />
			</layout>
		</appender>
	</log4net>

	<appSettings file="Endpoints.config">
		<!--
    Dominio de Red
    -->
		<add key="DominioRed" value="DINTERSEGURO" />

		<!--
    Parámetros Reporting Services
    -->
		<add key="DominioReportingServices" value="http://10.29.37.40/ReportServer" />
