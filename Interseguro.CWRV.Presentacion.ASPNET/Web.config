		<add key="ValidacionesCRM" value="N" />
		<add key="ValidacionesSDA" value="N" />
		<add key="ValidacionesCorreo" value="N" />

		<!--
    Notificaciones por Correo Electrónico
    Cuentas de usuario (AD) a las que deben llegar las notificaciones, separar por comas.
    - El parámetro EnviarNotificaciones va en S si se desean activar las notificaciones, N en caso contrario
    - Asegurarse de que los nombres de usuario estén bien escritos.
    - Si se desea enviar a más de un usuario, separarlos por comas.
    - Ejemplo: "hlaura,ralegre,lespinoza"
    -->
		<add key="EnviarNotificaciones" value="S" />
		<add key="EnviarNotificaciones" value="N" />
