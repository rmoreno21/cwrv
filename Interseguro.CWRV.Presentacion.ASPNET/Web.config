	</cotizacionesRPPlus>

	<!-- 
  Mensaje de correo electrónico predeterminado
  - Redacción del mensaje de correo electrónico que aparece por omisión.
  -->
	<correo>
		<asunto texto="Cotización IS_{ApellidoPaternoAfiliado} {ApellidoMaternoAfiliado} {NombreAfiliado}" />
		<mensaje>
			<![CDATA[{TratamientoAfiliado} {ApellidoPaternoAfiliado} {ApellidoMaternoAfiliado}, {NombreAfiliado}

De acuerdo a lo revisado el día de hoy, envío la cotización {TipoCotizacion}.

{NombreAgente}]]>
		</mensaje>
		<mensajesimulacion>
			<![CDATA[{TratamientoAfiliado} {ApellidoPaternoAfiliado} {ApellidoMaternoAfiliado}, {NombreAfiliado}

De acuerdo a lo revisado el día de hoy, envío la cotización.

{NombreAgente}]]>
		</mensajesimulacion>
