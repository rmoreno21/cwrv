		<add key="AplicacionAZMAN" value="CWRV" />
		<add key="IdSistemaSeguridad" value="262" />

		<!--
    Máximo de cotizaciones permitidas por solicitud
    - Colocar un valor numérico, entero positivo.
    -->
		<add key="MaxCotizaciones" value="20" />

		<!--
    Edades mínima y máxima de jubilación para el Simulador de Jubilarse Hoy o a Futruro
    - Colocar valores numéricos, enteros positivos.
    - La edad mínima debe ser menor o igual a la edad máxima.
    -->
		<add key="EdadMinJubilacion" value="65" />
		<add key="EdadMaxJubilacion" value="85" />

		<!--
    Indicador de dependencia del CRM (S/N)
    - Si el indicador se encuentra activo el CWRV sólo funcionará si se accede al mismo a través del CRM, caso contrario
      mostrará un mensaje indicando que debe accederse a través del CRM y no permitirá el inicio de sesión.
    - Si el indicador se encuentra inactivo, el CWRV no dependerá del CRM y podrá ser accedido desde su propio formulario
      de inicio de sesión.
    -->
		<add key="DependenciaCRM" value="N" />

		<!-- 
    Rango de IPs permitidas para Parámetros Especiales (ACOM, DCOM y TRA)
    - Se deben colocar los rangos de IP permitidos (el inicio si son varias o la IP completa si es alguna específica).
    - Separar por espacios en blanco si hay más de una.
    - Ejemplo: Para permitir a las IPs 126.26.10.XX y 128.28.10.XX colocar "126.26.10. 128.28.10.".
    -->
		<add key="RangoIPsParametrosEspeciales" value="::1 127.0.0.1 126.26.3. 126.26.10. 126.26.12. 126.26.110. 126.26.111. 126.26.255. 128.28.10. 128.28.12. 128.28.24. 128.28.110. 128.28.112. 10.5.61. 10.43.5. 10.43.7. 10.43.8. 10.48.24. 10.48.25. 153.30.1. 153.30.255. 153.40.2. 153.41.2. 153.61.3. 154.20.2. 155.13.2. 155.27.255. 156.20.2. 157.2.2. 157.20.1. 157.20.2. 157.23.2. 157.40.2. 157.60.2. 157.70.2. 130.30.2. 153.13.2. 172.22.16. 10.5.61.102 154.20.2.201 109.43.5.108 10.0.0.6 10.20. 10.21. 10.22. 10.23. 10.24. 10.25. 10.26. 10.27. 10.28. 10.29. 10.212.134. 10.19.18. 10.255.255." />

