  Cotizaciones predeterminadas
  - Lista de modalidades de cotización que aparecen por omisión cuando se crea una nueva solicitud.
  -->
	<cotizaciones>
		<add nro="1" moneda="001" producto="01" modalidad="D" periodoDiferido="1" pjeEntreRentras="50" periodoGarantizado="0" gratificacion="N" capital="-" />
		<add nro="2" moneda="001" producto="01" modalidad="I" periodoDiferido="0" pjeEntreRentras="0" periodoGarantizado="0" gratificacion="N" capital="-" />
		<add nro="3" moneda="014" producto="01" modalidad="I" periodoDiferido="0" pjeEntreRentras="0" periodoGarantizado="0" gratificacion="N" capital="-" />
		<add nro="4" moneda="014" producto="01" modalidad="I-RB" periodoDiferido="0" pjeEntreRentras="0" periodoGarantizado="0" gratificacion="N" capital="03" />
		<add nro="5" moneda="014" producto="01" modalidad="I-RM" periodoDiferido="0" pjeEntreRentras="0" periodoGarantizado="0" gratificacion="N" capital="03" />
		<add nro="6" moneda="013" producto="01" modalidad="I-RC" periodoDiferido="0" pjeEntreRentras="0" periodoGarantizado="0" gratificacion="N" capital="04" />
	</cotizaciones>

