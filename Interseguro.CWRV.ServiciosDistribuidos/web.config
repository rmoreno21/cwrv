	<system.web>
		<compilation targetFramework="4.0" debug="true" />
	</system.web>
	<system.serviceModel>
		<bindings>
			<netTcpBinding>
				<binding name="CWRVBindingNetTCP" maxBufferPoolSize="2147483646" maxBufferSize="2147483646" maxReceivedMessageSize="2147483646">
					<readerQuotas maxDepth="2147483646" maxStringContentLength="2147483646" maxArrayLength="2147483646" maxBytesPerRead="2147483646" maxNameTableCharCount="2147483646" />
				</binding>
			</netTcpBinding>
			<wsHttpBinding>
				<binding name="CWRVBindingWsHttp" maxReceivedMessageSize="33554432">
					<readerQuotas maxDepth="32" maxStringContentLength="33554432" maxArrayLength="33554432" maxBytesPerRead="33554432" maxNameTableCharCount="33554432" />
					<security mode="None" />
				</binding>
				<binding name="EPADMWR" closeTimeout="00:10:00" openTimeout="00:10:00" receiveTimeout="00:10:00" sendTimeout="00:10:00" bypassProxyOnLocal="false" transactionFlow="true" hostNameComparisonMode="StrongWildcard" maxBufferPoolSize="33554432" maxReceivedMessageSize="33554432" messageEncoding="Text" textEncoding="utf-8" useDefaultWebProxy="true" allowCookies="false" />
				<binding name="epAzman" />
				<binding name="EPMotorIFPws" closeTimeout="00:10:00" openTimeout="00:10:00" receiveTimeout="00:10:00" sendTimeout="00:10:00" bypassProxyOnLocal="false" transactionFlow="false" hostNameComparisonMode="StrongWildcard" maxBufferPoolSize="33554432" maxReceivedMessageSize="33554432" messageEncoding="Text" textEncoding="utf-8" useDefaultWebProxy="true" allowCookies="false" />
			</wsHttpBinding>
			<webHttpBinding>
				<binding name="webHttpBindingWithJsonP" crossDomainScriptAccessEnabled="true" />
			</webHttpBinding>
			<basicHttpBinding>
				<binding name="EPCWRV_Publico">
					<security mode="None" />
				</binding>
			</basicHttpBinding>

		</bindings>
		<services>
			<service behaviorConfiguration="CWRVBehavior" name="Interseguro.CWRV.ServiciosDistribuidos.ServicioCWRV">
				<endpoint address="" binding="wsHttpBinding" bindingConfiguration="CWRVBindingWsHttp" name="EPCWRV" contract="Interseguro.CWRV.ServiciosDistribuidos.IServicioCWRV" />
				<endpoint address="cotizador" binding="basicHttpBinding" bindingConfiguration="EPCWRV_Publico" contract="Interseguro.CWRV.ServiciosDistribuidos.IServicioCWRV_Publico" />
				<endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange" />
			</service>
			<service behaviorConfiguration="PlaftBehavior" name="Interseguro.CWRV.ServiciosDistribuidos.ServicioPlaft">
				<endpoint address="" binding="webHttpBinding" bindingConfiguration="webHttpBindingWithJsonP"
						  contract="Interseguro.CWRV.ServiciosDistribuidos.IServicioPlaft"
						  behaviorConfiguration="RESTPlaftEndpointBehavior"/>
			</service>
			

		</services>
		<behaviors>
			<serviceBehaviors>
				<behavior name="CWRVBehavior">
					<dataContractSerializer maxItemsInObjectGraph="2147483647"/>
					<serviceMetadata httpGetEnabled="true" />
					<serviceDebug includeExceptionDetailInFaults="true" httpHelpPageEnabled="true" />
				</behavior>
				<behavior name="PlaftBehavior">
					<serviceMetadata httpGetEnabled="true" />
					<serviceDebug includeExceptionDetailInFaults="true" />
					<dataContractSerializer />
				</behavior>

			</serviceBehaviors>
			<endpointBehaviors>
				<behavior name="RESTPlaftEndpointBehavior">
					<webHttp />
				</behavior>
			</endpointBehaviors>

    </behaviors>
    <serviceHostingEnvironment multipleSiteBindingsEnabled="true" />
	<client>
        <endpoint address="http://hotei-dev/wsAdmwr/ServiceADMWR.svc" binding="wsHttpBinding"
            bindingConfiguration="EPADMWR" contract="Proxies.ModuloADMWR.IServiceADMWR"
            name="EPADMWR">
