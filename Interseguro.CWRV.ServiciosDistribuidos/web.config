			</identity>
		</endpoint>
		<endpoint address="http://hotei-dev/wsMotorCalculo/ServicioMotorIFP.svc"
			binding="wsHttpBinding" bindingConfiguration="EPMotorIFPws" 
			contract="Proxies.MotorIFP.IServicioMotorIFP" name="EPMotorIFPws">
		<!-- address="http://localhost:6060/ServicioMotorIFP.svc" -->
			<identity> 
				<userPrincipalName value="cwrsepro@interseguro.com.pe" /> 
			</identity>
		</endpoint>
    </client>
	
	
